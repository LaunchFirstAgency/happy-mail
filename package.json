{
  "name": "@launchfirstagency/happy-mail",
  "version": "0.5.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/LaunchFirstAgency/happy-mail.git"
  },
  "description": "Email verification and validation to make you smile",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.mjs",
      "require": "./dist/internal.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "prepublish": "npm run build",
    "coverage": "jest --coverage",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "lodash": "4.17.21",
    "tld-extract": "2.1.0",
    "validator": "13.15.26"
  },
  "devDependencies": {
    "@jest/globals": "^29.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22",
    "@types/validator": "^13.15.0",
    "jest": "^29.6.1",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "semi": true,
    "arrowParens": "always",
    "printWidth": 100,
    "tabWidth": 2,
    "bracketSpacing": true
  }
}
